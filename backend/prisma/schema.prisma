// SilaiSetu — Tailor Management System
// Multi-tenant schema with shop isolation. Subscriptions deferred.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ShopRole {
  OWNER
  MANAGER
  TAILOR
}

enum ShopStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum OrderStatus {
  NEW
  CUTTING
  STITCHING
  TRIAL
  READY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  OTHER
}

enum PaymentKind {
  ADVANCE
  PARTIAL
  FINAL
  REVERSAL
  CORRECTION
}

enum MeasurementUnit {
  INCH
  CM
}

enum LanguageCode {
  en
  hi
  gu
}

enum ThemeModePref {
  LIGHT
  DARK
  SYSTEM
}

enum NotificationType {
  ORDER_STATUS
  DELIVERY_REMINDER
  OVERDUE
  READY
  PAYMENT_REMINDER
  SYSTEM
}

enum AuditAction {
  SHOP_ACTIVATED
  SHOP_SUSPENDED
  SHOP_REACTIVATED
  PLATFORM_SETTINGS_CHANGED
  ADMIN_LOGIN
  ADMIN_ACCESS_DENIED
  MEMBERSHIP_CHANGED
  OTHER
}

model User {
  id                    String         @id @default(uuid()) @db.Uuid
  /// Optional when registering with phone only
  email                 String?        @unique
  /// E.164 normalized phone when present (e.g. +919876543210)
  phone                 String?        @unique
  altPhone              String?
  passwordHash          String
  fullName              String
  avatarUrl             String?
  isActive              Boolean        @default(true)
  emailVerifiedAt       DateTime?
  phoneVerifiedAt       DateTime?
  languagePref          LanguageCode   @default(gu)
  themePref             ThemeModePref  @default(SYSTEM)
  /// 0 = not started, 1-5 = shop onboarding steps, 6 = complete
  onboardingStep        Int            @default(0)
  onboardingDraft       Json?
  onboardingCompletedAt DateTime?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  memberships      ShopMembership[]
  refreshTokens    RefreshToken[]
  authTokens       AuthToken[]
  platformAdmin    PlatformAdmin?
  createdCustomers Customer[]     @relation("CustomerCreatedBy")
  createdOrders    StitchingOrder[] @relation("OrderCreatedBy")
  payments         Payment[]      @relation("PaymentRecordedBy")
  measurements     MeasurementRecord[] @relation("MeasurementCreatedBy")
  notifications    Notification[]
  statusChanges    OrderStatusHistory[] @relation("StatusChangedBy")
  auditLogs        AuditLog[]     @relation("AuditActor")

  @@map("users")
}

enum AuthTokenPurpose {
  PASSWORD_RESET
  EMAIL_VERIFY
  PHONE_VERIFY
  RECOVERY_HINT
}

model AuthToken {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   AuthTokenPurpose
  /// SHA-256 of OTP or reset token — never store plaintext
  tokenHash String
  expiresAt DateTime
  usedAt    DateTime?
  meta      Json?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
  @@index([tokenHash])
  @@map("auth_tokens")
}

model PlatformAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isSuperAdmin Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("platform_admins")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model Shop {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  slug            String      @unique
  phone           String?
  email           String?
  altPhone        String?
  ownerDisplayName String?
  logoUrl         String?
  description     String?
  addressLine1    String?
  addressLine2    String?
  area            String?
  address         String?
  city            String?
  state           String?
  pincode         String?
  country         String      @default("IN")
  status          ShopStatus  @default(PENDING)
  defaultLanguage LanguageCode @default(gu)
  measurementUnit MeasurementUnit @default(INCH)
  currencyCode    String      @default("INR")
  workingHours    Json?
  preferences     Json?
  /// Idempotency key from client finish request
  createIdempotencyKey String? @unique
  onboardingCompletedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  memberships     ShopMembership[]
  settings        ShopSettings?
  customers       Customer[]
  garmentTemplates GarmentTemplate[]
  measurements    MeasurementRecord[]
  orders          StitchingOrder[]
  payments        Payment[]
  notifications   Notification[]
  statusHistory   ShopStatusHistory[]
  auditLogs       AuditLog[]

  @@index([status])
  @@index([createdAt])
  @@map("shops")
}

model ShopMembership {
  id        String    @id @default(uuid()) @db.Uuid
  shopId    String    @db.Uuid
  userId    String    @db.Uuid
  role      ShopRole
  isActive  Boolean   @default(true)
  invitedAt DateTime  @default(now())
  joinedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  assignedOrders StitchingOrder[] @relation("OrderAssignee")

  @@unique([shopId, userId])
  @@index([userId])
  @@index([shopId, role])
  @@map("shop_memberships")
}

model ShopSettings {
  id                 String         @id @default(uuid()) @db.Uuid
  shopId             String         @unique @db.Uuid
  shop               Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  receiptHeader      String?
  receiptFooter      String?
  receiptLanguage    LanguageCode   @default(gu)
  receiptContact     String?
  enableTrials       Boolean        @default(true)
  defaultAdvancePct  Decimal?       @db.Decimal(5, 2)
  taxEnabled         Boolean        @default(false)
  taxPercent         Decimal?       @db.Decimal(5, 2)
  taxId              String?
  paymentMethods     Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@map("shop_settings")
}

model ShopStatusHistory {
  id         String     @id @default(uuid()) @db.Uuid
  shopId     String     @db.Uuid
  shop       Shop       @relation(fields: [shopId], references: [id], onDelete: Cascade)
  fromStatus ShopStatus?
  toStatus   ShopStatus
  reason     String?
  actorId    String?    @db.Uuid
  createdAt  DateTime   @default(now())

  @@index([shopId, createdAt])
  @@map("shop_status_history")
}

model Customer {
  id           String    @id @default(uuid()) @db.Uuid
  shopId       String    @db.Uuid
  shop         Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  fullName     String
  phone        String
  altPhone     String?
  email        String?
  address      String?
  notes        String?
  isArchived   Boolean   @default(false)
  createdById  String?   @db.Uuid
  createdBy    User?     @relation("CustomerCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  measurements MeasurementRecord[]
  orders       StitchingOrder[]
  payments     Payment[]

  @@index([shopId, phone])
  @@index([shopId, fullName])
  @@index([shopId, isArchived])
  @@map("customers")
}

model GarmentTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  shopId      String   @db.Uuid
  shop        Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  code        String
  description String?
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  /// JSON array of field definitions: { id, name, type, unit, required, order, helpText, defaultValue, validation }
  fields      Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  measurements MeasurementRecord[]
  orderItems   OrderItem[]

  @@unique([shopId, code])
  @@index([shopId, isActive])
  @@map("garment_templates")
}

model MeasurementRecord {
  id                String          @id @default(uuid()) @db.Uuid
  shopId            String          @db.Uuid
  shop              Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId        String          @db.Uuid
  customer          Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  garmentTemplateId String          @db.Uuid
  garmentTemplate   GarmentTemplate @relation(fields: [garmentTemplateId], references: [id])
  version           Int             @default(1)
  unit              MeasurementUnit
  /// Validated values matching template fields
  values            Json
  notes             String?
  createdById       String?         @db.Uuid
  createdBy         User?           @relation("MeasurementCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt         DateTime        @default(now())

  @@index([shopId, customerId])
  @@index([customerId, garmentTemplateId, version])
  @@map("measurement_records")
}

model StitchingOrder {
  id              String      @id @default(uuid()) @db.Uuid
  shopId          String      @db.Uuid
  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  customerId      String      @db.Uuid
  customer        Customer    @relation(fields: [customerId], references: [id])
  orderNumber     String
  status          OrderStatus @default(NEW)
  trialDate       DateTime?
  deliveryDate    DateTime?
  subtotal        Decimal     @db.Decimal(12, 2)
  discount        Decimal     @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  amountPaid      Decimal     @default(0) @db.Decimal(12, 2)
  balanceDue      Decimal     @db.Decimal(12, 2)
  currencyCode    String      @default("INR")
  notes           String?
  assignedToId    String?     @db.Uuid
  assignedTo      ShopMembership? @relation("OrderAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdById     String?     @db.Uuid
  createdBy       User?       @relation("OrderCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  deliveredAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]

  @@unique([shopId, orderNumber])
  @@index([shopId, status])
  @@index([shopId, deliveryDate])
  @@index([shopId, customerId])
  @@index([assignedToId])
  @@map("stitching_orders")
}

model OrderItem {
  id                String   @id @default(uuid()) @db.Uuid
  orderId           String   @db.Uuid
  order             StitchingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  garmentTemplateId String?  @db.Uuid
  garmentTemplate   GarmentTemplate? @relation(fields: [garmentTemplateId], references: [id], onDelete: SetNull)
  garmentName       String
  quantity          Int      @default(1)
  unitPrice         Decimal  @db.Decimal(12, 2)
  lineTotal         Decimal  @db.Decimal(12, 2)
  styleNotes        String?
  fabricInfo        String?
  /// Immutable snapshot of measurements + template fields at order time
  measurementSnapshot Json?
  createdAt         DateTime @default(now())

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id         String      @id @default(uuid()) @db.Uuid
  orderId    String      @db.Uuid
  order      StitchingOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  changedById String?    @db.Uuid
  changedBy  User?       @relation("StatusChangedBy", fields: [changedById], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model Payment {
  id              String        @id @default(uuid()) @db.Uuid
  shopId          String        @db.Uuid
  shop            Shop          @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId         String        @db.Uuid
  order           StitchingOrder @relation(fields: [orderId], references: [id])
  customerId      String        @db.Uuid
  customer        Customer      @relation(fields: [customerId], references: [id])
  amount          Decimal       @db.Decimal(12, 2)
  kind            PaymentKind
  method          PaymentMethod @default(CASH)
  reference       String?
  notes           String?
  idempotencyKey  String?
  isReversed      Boolean       @default(false)
  reversesPaymentId String?     @db.Uuid
  recordedById    String?       @db.Uuid
  recordedBy      User?         @relation("PaymentRecordedBy", fields: [recordedById], references: [id], onDelete: SetNull)
  createdAt       DateTime      @default(now())

  @@unique([shopId, idempotencyKey])
  @@index([shopId, orderId])
  @@index([shopId, customerId])
  @@index([shopId, createdAt])
  @@map("payments")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  shopId    String?          @db.Uuid
  shop      Shop?            @relation(fields: [shopId], references: [id], onDelete: Cascade)
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  payload   Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@index([shopId, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  shopId     String?     @db.Uuid
  shop       Shop?       @relation(fields: [shopId], references: [id], onDelete: SetNull)
  actorId    String?     @db.Uuid
  actor      User?       @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     AuditAction
  targetType String
  targetId   String?
  reason     String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([shopId, createdAt])
  @@index([action])
  @@map("audit_logs")
}

model PlatformSettings {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@map("platform_settings")
}
