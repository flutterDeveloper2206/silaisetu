NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# Local PostgreSQL (Homebrew or Docker)
DATABASE_URL=postgresql://silaisetu:silaisetu_dev_only@localhost:5432/silaisetu?schema=public

# Optional RLS runtime role (document in security docs)
# DATABASE_URL_APP=postgresql://silaisetu_app:silaisetu_app_dev_only@localhost:5432/silaisetu?schema=public

JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars_long
JWT_ACCESS_EXPIRES=30d
JWT_REFRESH_EXPIRES=30d

# Local platform admin bootstrap (seed / bootstrap script only)
PLATFORM_ADMIN_EMAIL=admin@silaisetu.local
PLATFORM_ADMIN_PASSWORD=ChangeMe_Admin_123!
PLATFORM_ADMIN_NAME=Platform Admin

THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=20
COOKIE_SECURE=false
APP_VERSION=0.1.0

# Auth: local/dev — expose OTP/reset tokens in API for testing only
AUTH_DEV_EXPOSE_CODES=true
# Set true in production-like envs to require email/phone verification
AUTH_REQUIRE_VERIFICATION=false
SUPPORT_EMAIL=support@silaisetu.local
# Optional providers (leave empty for local — codes logged / returned via AUTH_DEV_EXPOSE_CODES)
# SMTP_URL=
# SMS_PROVIDER_API_KEY=

