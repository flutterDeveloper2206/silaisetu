NODE_ENV=production
PORT=3000
API_PREFIX=api/v1

# Neon (or other managed Postgres) — include sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

JWT_ACCESS_SECRET=replace_with_long_random_access_secret_min_32
JWT_REFRESH_SECRET=replace_with_long_random_refresh_secret_min_32
JWT_ACCESS_EXPIRES=30d
JWT_REFRESH_EXPIRES=30d

COOKIE_SECURE=true
AUTH_DEV_EXPOSE_CODES=false
AUTH_REQUIRE_VERIFICATION=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
APP_VERSION=0.1.0
SUPPORT_EMAIL=support@yourdomain.com

# Optional seed (run once via shell, not required at boot)
# PLATFORM_ADMIN_EMAIL=admin@yourdomain.com
# PLATFORM_ADMIN_PASSWORD=ChangeMe_Strong_Password!
# PLATFORM_ADMIN_NAME=Platform Admin
